# Copy to .env.local for local development. Never commit the real file
# (constitution §5 — secrets in env only; .env* is gitignored except this template).

# Database — pooled Postgres+PostGIS connection string (T1.5 / T1.3)
DATABASE_URL=

# Auth.js
AUTH_SECRET=

# Player email one-time-code (ADR-0003). The sender resolves its transport
# from these at call time: Resend if RESEND_API_KEY (+ EMAIL_FROM) is set,
# else SMTP if the SMTP_* vars (+ EMAIL_FROM) are set, else a dev fallback
# that logs the code server-side. Leave all blank for the dev fallback.
EMAIL_FROM=
# Option A — Resend REST API (no SDK dependency)
RESEND_API_KEY=
# Option B — SMTP (via nodemailer)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# Cloudflare R2 — submission photo storage (T2.4)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Mapbox — public token is URL-restricted, safe for client bundle (T4.4/T5.2)
NEXT_PUBLIC_MAPBOX_TOKEN=
